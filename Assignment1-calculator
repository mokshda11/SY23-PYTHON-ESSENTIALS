n1=int(input("Enter first number: "))
n2=int(input("Enter second number: "))

#Addition
n3=n1+n2
print("The sum of ", n1, "and", n2, "is: ", n3)

#Subtraction
n4=n1-n2
print("The difference of ", n1, "and", n2, " is: ", n4)

#Multiplication
n5=n1*n2
print("The product of ", n1, "and", n2, " is: ", n5)

#Division
n6=n1/n2
print("The quotient of ", n1, "and", n2, " is: ", n6)

#Modulus
n7=n1%n2
print("The remainder of ", n1, "and", n2, " is: ", n7)

#Exponent
n8=n1**n2
print("The exponent of ", n1, "and", n2, " is: ", n8)

#Floor Division
